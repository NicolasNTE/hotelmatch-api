      "name": "1. Autenticación y seguridad",
      "item": [
        {
          "name": "01 Login huésped",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const add = (n) => { const d = new Date(); d.setDate(d.getDate() + n); return d.toISOString().slice(0, 10); };",
                  "const start = 40 + Math.floor(Math.random() * 900);",
                  "pm.collectionVariables.set('checkIn', add(start));",
                  "pm.collectionVariables.set('checkOut', add(start + 2));",
                  "pm.collectionVariables.set('reportFrom', add(0));",
                  "pm.collectionVariables.set('reportTo', add(30));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Devuelve un token JWT\", () => pm.expect(pm.response.json().accessToken).to.be.a(\"string\"));",
                  "pm.collectionVariables.set('guestToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{guestEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
