# Imagen de la API para el runtime de contenedores de Vercel.
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app
COPY pom.xml .
COPY src src
# Las pruebas corren en GitHub Actions; aquí solo se empaqueta.
RUN mvn -B -DskipTests package

FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /app/target/hotelmatch-api-0.1.0-SNAPSHOT.jar app.jar
ENV SPRING_PROFILES_ACTIVE=cloud PORT=8080
USER 10001
EXPOSE 8080
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-XX:TieredStopAtLevel=1", "-jar", "app.jar"]
